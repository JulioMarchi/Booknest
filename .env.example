# ──────────────────────────────────────────────────────────────
# BookNest — Variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha os valores reais.
# NUNCA faça commit do ".env.local" (já está no .gitignore).
# ──────────────────────────────────────────────────────────────

# Supabase — Configurações > API no painel do projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — chave de serviço (bypassa RLS). Usada SOMENTE em código
# server-side (webhooks, geração de Signed URLs). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (sem barra no final). Usada em metadata, sitemap,
# e-mails e no redirect_to do fluxo de autenticação.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — Desenvolvedores > Chaves de API
STRIPE_SECRET_KEY=
# Opcional no fluxo atual (checkout redireciona para a página hospedada
# do Stripe, sem usar @stripe/stripe-js no client). Só é necessária se
# um dia adicionar Stripe Elements embutido na própria página.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe — Desenvolvedores > Webhooks > Signing secret (gerado ao criar
# o endpoint do webhook; configurado na Fase 5)
STRIPE_WEBHOOK_SECRET=
